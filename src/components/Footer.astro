---
import { BUSINESS_NAME, PRIVACY_URL, WHATSAPP_NUMBER } from '../consts';
---

<footer class="site-footer">
	<!-- Aviso antifraude (pedido en el Google Site): primer elemento del footer, separado del resto por una línea -->
	<div class="container footer-notice">
		<div class="fraud-notice" role="note">
			<span class="fraud-notice-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3z"></path><path d="M12 10v4M12 17h.01"></path></svg>
			</span>
			<p class="fraud-notice-text">
				<strong>Aviso importante</strong>
				Ninguno de nuestros asesores solicita dinero por adelantado ni depósitos de garantía. Cotiza únicamente a través de nuestro WhatsApp oficial.
			</p>
			<a class="fraud-notice-cta" href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener" aria-label="WhatsApp oficial: 81 1081 6677">
				<!-- Ícono: Bootstrap Icons (MIT) -->
				<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"></path></svg>
				81 1081 6677
			</a>
		</div>
	</div>
	<div class="container footer-inner">
		<img class="logo-img logo-img-footer" src="/logos/logo-white-sm.png" width="149" height="80" alt={BUSINESS_NAME} loading="lazy" />
		<p class="footer-copy">
			© {new Date().getFullYear()} {BUSINESS_NAME} · <a href={PRIVACY_URL}>Aviso de privacidad</a>
		</p>
	</div>
</footer>
