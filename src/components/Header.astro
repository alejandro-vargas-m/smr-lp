---
import { BUSINESS_NAME, DEFAULT_CTA } from '../consts';

interface Props {
	// Header transparente sobre el hero (solo en la portada)
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
// Fuera de la portada, los anclas apuntan a las secciones del inicio
const prefix = overlay ? '' : '/';
---

{overlay && <div class="header-sentinel" aria-hidden="true"></div>}
<header class="site-header">
	<div class="container header-inner">
		<a class="header-logo" href="/" aria-label={`${BUSINESS_NAME}, ir al inicio`}>
			<img class="logo-img logo-on-light" src="/logos/logo-color-sm.png" width="179" height="96" alt="" />
			<img class="logo-img logo-on-dark" src="/logos/logo-white-sm.png" width="149" height="80" alt="" aria-hidden="true" />
		</a>
		<nav class="main-nav" aria-label="Navegación principal">
			<a href={`${prefix}#surtimos`}>Zonas</a>
			<a href={`${prefix}#como-cotizar`}>Cómo cotizar</a>
			<a href={`${prefix}#contacto`}>Contacto</a>
		</nav>
		<a class="btn btn-whatsapp btn-header" href={DEFAULT_CTA}>Cotiza por WhatsApp</a>
	</div>
</header>
{
	overlay && (
		<script is:inline>
			// Header transparente sobre el hero; se vuelve sólido al hacer scroll.
			// Solo se activa con JS: sin él, el header se queda sólido y legible.
			(() => {
				const header = document.querySelector('.site-header');
				const sentinel = document.querySelector('.header-sentinel');
				if (!header || !sentinel || !('IntersectionObserver' in window)) return;
				const setHeight = () => document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
				setHeight();
				window.addEventListener('resize', setHeight, { passive: true });
				document.documentElement.classList.add('has-overlay-header');
				header.classList.add('is-overlay');
				new IntersectionObserver(([entry]) => header.classList.toggle('is-overlay', entry.isIntersecting)).observe(sentinel);
			})();
		</script>
	)
}
