---
import Layout from '../layouts/Layout.astro';

const WHATSAPP_NUMBER = '528110816677';
const waLink = (text: string) => `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
// Ficha de Google Maps del negocio (CID)
const MAPS_CID = '17355579856265802874';
const MAPS_URL = `https://maps.google.com/?cid=${MAPS_CID}`;
const FACEBOOK_URL = 'https://www.facebook.com/profile.php?id=61584890513502';
const INSTAGRAM_URL = 'https://www.instagram.com/supermaterialesregiomontanos';
const TIKTOK_URL = 'https://www.tiktok.com/@smaterialesregiomontanos';
const defaultCta = waLink('Hola, quiero cotizar materiales de construcción');

const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);

// Datos estructurados para Google (negocio local). Sin horario hasta que el cliente lo confirme.
const localBusiness = {
	'@context': 'https://schema.org',
	'@type': 'HardwareStore',
	name: 'Super Materiales Regiomontanos',
	description: 'Casa de materiales para construcción en el sur de Monterrey: block, tablaroca, varilla, cemento, arena y grava.',
	image: abs('/og-image.jpg'),
	logo: abs('/logos/logo-color.png'),
	telephone: '+52 81 1081 6677',
	email: 'materialesregiomontanos@gmail.com',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Cañón Grande 7780, Villas La Rioja',
		addressLocality: 'Monterrey',
		addressRegion: 'N.L.',
		postalCode: '64988',
		addressCountry: 'MX',
	},
	geo: { '@type': 'GeoCoordinates', latitude: 25.5895018, longitude: -100.2548594 },
	hasMap: MAPS_URL,
	areaServed: ['Santiago', 'El Barrial', 'El Uro', 'Los Rodríguez', 'Garza Sada', 'Revolución', 'Carretera Nacional'],
	sameAs: [FACEBOOK_URL, INSTAGRAM_URL, TIKTOK_URL],
};
---

<Layout>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
	<header class="site-header">
		<div class="container header-inner">
			<img class="logo-img" src="/logos/logo-color-sm.png" width="179" height="96" alt="Super Materiales Regiomontanos" />
			<nav class="main-nav" aria-label="Navegación principal">
				<a href="#surtimos">Zonas</a>
				<a href="#como-cotizar">Cómo cotizar</a>
				<a href="#contacto">Contacto</a>
			</nav>
			<a class="btn btn-whatsapp btn-header" href={defaultCta}>Cotiza por WhatsApp</a>
		</div>
	</header>

	<main id="main">
		<!-- HERO -->
		<section class="hero">
			<div class="container hero-inner">
				<h1>MATERIALES PARA CONSTRUCCIÓN EN EL SUR DE MONTERREY</h1>
				<p class="hero-copy">Cotiza block, tablaroca, varilla, cemento, arena y grava por WhatsApp. Te ayudamos a calcular lo que necesitas.</p>
				<a class="btn btn-whatsapp btn-lg" href={defaultCta}>Cotiza por WhatsApp</a>
				<p class="hero-zones">Atendemos Santiago, El Uro, Los Rodríguez, Garza Sada y Revolución.</p>
			</div>
		</section>

		<!-- TABLAROCA Y BLOCK -->
		<section class="section reveal">
			<div class="container">
				<h2>TABLAROCA Y BLOCK EN MONTERREY PARA CADA ETAPA DE TU OBRA</h2>
				<p class="section-intro">Surtimos desde la remodelación de tu casa hasta el abasto de una constructora, con precios por volumen y asesoría para que compres lo justo.</p>

				<div class="two-col-cards">
					<div class="card">
						<figure class="img-slot img-slot-card" data-pending-asset="Tablaroca">
							<img src="/img/temp/tablaroca.jpg" alt="Hojas de tablaroca" loading="lazy" />
						</figure>
						<h3>Tablaroca</h3>
						<p>Para muros, plafones y divisiones. Arma tu pedido completo con todos sus complementos.</p>
						<ul class="checklist">
							<li>Hojas de 1/2 y 5/8</li>
							<li>Resistente a la humedad</li>
							<li>Durock y tablacemento</li>
							<li>Postes y canales</li>
							<li>Perfacinta y pasta</li>
							<li>Precio por volumen</li>
						</ul>
					</div>
					<div class="card">
						<figure class="img-slot img-slot-card" data-pending-asset="Block">
							<img src="/img/temp/block.jpg" alt="Block de concreto apilado" loading="lazy" />
						</figure>
						<h3>Block</h3>
						<p>Para bardas, ampliaciones o casa nueva. Mándanos tus medidas y te calculamos las piezas.</p>
						<ul class="checklist">
							<li>Block hueco de 12, 15 y 20</li>
							<li>Medida 15x20x40</li>
							<li>Por millar o mayoreo</li>
							<li>Cálculo de piezas</li>
							<li>Entrega en obra*</li>
						</ul>
						<p class="price-placeholder">Desde $[precio] por pieza*</p>
					</div>
				</div>
				<p class="footnote">*Precio sujeto a compra mínima de [cantidad] piezas y disponibilidad. Entrega según zona y pedido.</p>
			</div>
		</section>

		<!-- AGREGA A TU PEDIDO -->
		<section class="section section-light reveal">
			<div class="container">
				<h2>AGREGA A TU PEDIDO</h2>
				<div class="product-grid">
					<div class="product-card">
						<figure class="img-slot img-slot-icon" data-pending-asset="Varilla y acero">
							<img src="/img/temp/varilla.jpg" alt="Varilla corrugada" loading="lazy" />
						</figure>
						<h3>Varilla y acero</h3>
						<p>Varilla corrugada de 3/8 y otras medidas, alambrón y alambre recocido. Precio por tonelada.</p>
					</div>
					<div class="product-card">
						<figure class="img-slot img-slot-icon" data-pending-asset="Cemento">
							<img src="/img/temp/cemento.jpg" alt="Bultos de cemento" loading="lazy" />
						</figure>
						<h3>Cemento</h3>
						<p>Cemento gris por bulto o por tonelada, para colados, enjarres y firmes.</p>
					</div>
					<div class="product-card">
						<figure class="img-slot img-slot-icon" data-pending-asset="Arena y grava">
							<img src="/img/temp/arena.jpg" alt="Arena y grava para construcción" loading="lazy" />
						</figure>
						<h3>Arena y grava</h3>
						<p>Arena y grava para construcción, por viaje y con entrega según zona.</p>
					</div>
					<div class="product-card">
						<figure class="img-slot img-slot-icon" data-pending-asset="Impermeabilizantes">
							<img src="/img/temp/imper.jpg" alt="Aplicación de impermeabilizante en techo" loading="lazy" />
						</figure>
						<h3>Impermeabilizantes</h3>
						<p>Para techo y losa, en cubeta de 19 L. Prepárate antes de la temporada de lluvias.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- COTIZAR ES ASÍ DE SENCILLO -->
		<section id="como-cotizar" class="section section-orange reveal">
			<div class="container">
				<h2>COTIZAR ES ASÍ DE SENCILLO</h2>
				<div class="steps">
					<div class="step">
						<div class="step-icon" aria-hidden="true">
							<span class="step-number">1</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
						</div>
						<h3>Mándanos tu lista o tus medidas</h3>
						<p>Por WhatsApp, con una foto de tu lista, tu plano o solo las medidas de lo que vas a construir.</p>
					</div>
					<div class="step">
						<div class="step-icon" aria-hidden="true">
							<span class="step-number">2</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 7h6m-6 4h6m-6 4h4M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path></svg>
						</div>
						<h3>Te calculamos y cotizamos</h3>
						<p>Te respondemos rápido con precios, cantidades y el material complementario que vas a necesitar.</p>
					</div>
					<div class="step">
						<div class="step-icon" aria-hidden="true">
							<span class="step-number">3</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z"></path><circle cx="7.5" cy="17.5" r="1.5"></circle><circle cx="17.5" cy="17.5" r="1.5"></circle></svg>
						</div>
						<h3>Coordinamos tu entrega</h3>
						<p>Con nuestras propias unidades, según tu zona y tu pedido, al ritmo de tu obra.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- REMODELA / OBRA -->
		<section class="section reveal">
			<div class="container two-col-panels">
				<div class="panel">
					<h2>SI ESTÁS REMODELANDO TU CASA</h2>
					<p>Un cuarto más, una barda o un plafón nuevo. Te orientamos para que compres solo lo que tu proyecto necesita, sin dar vueltas entre tiendas.</p>
				</div>
				<div class="panel panel-accent">
					<h2>SI DIRIGES UNA OBRA</h2>
					<p>Constructoras, contratistas e ingenieros: precios por volumen, abasto continuo y entregas programadas según el avance de tu proyecto.</p>
				</div>
			</div>
		</section>

		<!-- MATERIAL Y UNIDADES PROPIAS -->
		<section class="section section-light reveal">
			<div class="container">
				<h2>MATERIAL Y UNIDADES PROPIAS PARA TU OBRA</h2>
				<div class="photo-grid">
					<figure class="photo-placeholder" data-pending-asset="Camiones en reparto">
						<img src="/img/temp/camion.jpg" alt="Camión de reparto de materiales" loading="lazy" />
						<figcaption>Camiones en reparto</figcaption>
					</figure>
					<figure class="photo-placeholder" data-pending-asset="Entrega en obra">
						<img src="/img/temp/entrega.jpg" alt="Entrega de material en obra" loading="lazy" />
						<figcaption>Entrega en obra</figcaption>
					</figure>
					<figure class="photo-placeholder" data-pending-asset="Almacén y patio">
						<img src="/img/temp/almacen.jpg" alt="Patio de materiales para construcción" loading="lazy" />
						<figcaption>Almacén y patio</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<!-- SURTIMOS EL SUR DE MONTERREY -->
		<section id="surtimos" class="section reveal">
			<div class="container surtimos-grid">
				<div>
					<h2>SURTIMOS EL SUR DE MONTERREY</h2>
					<p class="section-intro">Conocemos la zona y llegamos a tu obra con nuestras propias unidades.</p>
					<ul class="zone-list">
						<li>Santiago</li>
						<li>El Barrial y El Uro</li>
						<li>Los Rodríguez</li>
						<li>Corredor Garza Sada</li>
						<li>Corredor Revolución</li>
						<li>Carretera Nacional</li>
					</ul>
					<p class="footnote">Las entregas y el flete dependen de la zona, el monto y la disponibilidad. Pregúntanos por tu ubicación.</p>
				</div>
				<div class="map-placeholder" data-pending-asset="Mapa de las zonas">
					<iframe
						title="Mapa de las zonas que surtimos en el sur de Monterrey"
						src={`https://maps.google.com/maps?cid=${MAPS_CID}&z=13&output=embed&hl=es`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</section>

		<!-- CONTACTO -->
		<section id="contacto" class="section section-orange reveal">
			<div class="container contact-grid">
				<div class="contact-info">
					<h2>MÁNDANOS TU LISTA Y TE COTIZAMOS HOY</h2>
					<p>Casa de materiales en el sur de Monterrey.</p>
					<ul class="contact-details">
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
							<a href={MAPS_URL} target="_blank" rel="noopener">Cañón Grande 7780, Villas La Rioja, 64988 Monterrey, N.L.</a>
						</li>
						<!-- Horario pendiente de confirmar con el cliente (no aparece en el Google Site ni en Facebook sin sesión) -->
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
							<span>Lunes a sábado, 7 a.m.–7 p.m. Domingo cerrado</span>
						</li>
						<li>
							<!-- Ícono: Bootstrap Icons (MIT) -->
							<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"></path></svg>
							<span>WhatsApp: <a href={`https://wa.me/${WHATSAPP_NUMBER}`}>81 1081 6677</a></span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
							<span>Teléfono: <a href="tel:+528110816677">81 1081 6677</a> · <a href="tel:+528110816655">81 1081 6655</a></span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
							<a href="mailto:materialesregiomontanos@gmail.com">materialesregiomontanos@gmail.com</a>
						</li>
					</ul>

					<div class="social-links">
						<span class="social-label">Síguenos</span>
						<a href={FACEBOOK_URL} target="_blank" rel="noopener" aria-label="Facebook de Super Materiales Regiomontanos">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.5-1 .9-1H17V2.1L14 2c-3.3 0-4 2.5-4 4.1v2.4H7.5V12H10v10h4V12h2.8l.4-3.5H14z"></path></svg>
						</a>
						<a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Instagram de Super Materiales Regiomontanos">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></svg>
						</a>
						<a href={TIKTOK_URL} target="_blank" rel="noopener" aria-label="TikTok de Super Materiales Regiomontanos">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.1-2.8V9.1a6.3 6.3 0 1 0 5.5 6.3V8.6a7.8 7.8 0 0 0 4.4 1.4V6.6a4.5 4.5 0 0 1-4.4-4.6z"></path></svg>
						</a>
					</div>
				</div>

				<form class="contact-form" id="quote-form" novalidate>
					<h3>Contacto</h3>
					<label>Nombre completo:
						<input type="text" name="nombre" autocomplete="name" required />
					</label>
					<label>Tipo de cliente:
						<select name="tipo_cliente" required>
							<option value="">Selecciona una opción</option>
							<option value="particular">Particular / remodelación</option>
							<option value="contratista">Contratista / constructora</option>
						</select>
					</label>
					<label>Ubicación:
						<input type="text" name="ubicacion" autocomplete="address-level2" required />
					</label>
					<label>Teléfono:
						<input type="tel" name="telefono" autocomplete="tel" pattern="(?:\D*\d){10,}\D*" title="Escribe un teléfono de al menos 10 dígitos" required />
					</label>
					<label>Correo:
						<input type="email" name="correo" autocomplete="email" />
					</label>
					<label>Materiales de interés:
						<input type="text" name="materiales" />
					</label>
					<label>Medidas:
						<textarea name="medidas" rows="3"></textarea>
					</label>
					<button type="submit" class="btn btn-whatsapp btn-lg">Cotizar</button>
					<p class="form-note" id="form-note" role="status"></p>
				</form>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container footer-inner">
			<img class="logo-img logo-img-footer" src="/logos/logo-white-sm.png" width="149" height="80" alt="Super Materiales Regiomontanos" loading="lazy" />
			<div class="footer-links">
				<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
				<a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
				<a href={TIKTOK_URL} target="_blank" rel="noopener">TikTok</a>
				<a href="#contacto">Contactar</a>
			</div>
		</div>
	</footer>


	<script>
		const sections = document.querySelectorAll('.reveal');
		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15 },
			);
			sections.forEach((section) => observer.observe(section));
		} else {
			sections.forEach((section) => section.classList.add('is-visible'));
		}
	</script>

	<script define:vars={{ WHATSAPP_NUMBER }}>
		const form = document.getElementById('quote-form');
		const note = document.getElementById('form-note');

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			const data = new FormData(form);
			const tipoCliente = data.get('tipo_cliente') === 'contratista' ? 'Contratista / constructora' : 'Particular / remodelación';
			const lines = [
				'Hola, quiero cotizar materiales de construcción.',
				`Nombre: ${data.get('nombre')}`,
				`Tipo de cliente: ${tipoCliente}`,
				`Ubicación: ${data.get('ubicacion')}`,
				`Teléfono: ${data.get('telefono')}`,
				data.get('correo') ? `Correo: ${data.get('correo')}` : null,
				data.get('materiales') ? `Materiales de interés: ${data.get('materiales')}` : null,
				data.get('medidas') ? `Medidas: ${data.get('medidas')}` : null,
			].filter(Boolean);

			const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines.join('\n'))}`;
			note.textContent = 'Abriendo WhatsApp...';
			// Si el navegador bloquea la ventana nueva, abrir en la misma pestaña
			if (!window.open(url, '_blank')) window.location.href = url;
		});
	</script>
</Layout>
