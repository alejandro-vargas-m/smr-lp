---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	// Páginas que no deben aparecer en buscadores (gracias, borradores)
	noindex?: boolean;
}

const {
	title = 'Materiales para construcción en el sur de Monterrey | Super Materiales Regiomontanos',
	description = 'Materiales para construcción en el sur de Monterrey. Cotiza block, tablaroca, varilla, cemento, arena y grava por WhatsApp.',
	image = '/og-image.jpg',
	noindex = false,
} = Astro.props;

// Con `site` definido en astro.config.mjs las URLs salen absolutas (las redes sociales lo requieren)
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = Astro.site ? new URL(image, Astro.site).href : image;
---

<!DOCTYPE html>
<html lang="es-MX">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#F26522" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="Super Materiales Regiomontanos" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" href="/fonts/eurostile-extended-black.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">Saltar al contenido principal</a>
		<slot />
		<!-- Chatbot de Conversia: necesita document.body y el id "chatbot-js" para ubicar sus recursos -->
		<script is:inline src="https://conversia.com.mx/assets/js/chatbot.js" id="chatbot-js"></script>
		<script is:inline>
			CHATKODEX.init({
				host: window.location.host,
				key: 'ntTNpQviDH41G',
			});
		</script>
	</body>
</html>
